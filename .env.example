# Analyzer V5 Rebuild — copy to .env and fill in. NEVER commit .env.

BPP_DATA_ROOT=/absolute/path/to/data

# Bundle Server
BPP_V5_API_BASE_URL=
BPP_BUNDLE_SYNC_TOKEN=

# R2 (public metrics bucket, prefix analyzer-v5/)
BPP_METRICS_R2_ACCOUNT_ID=
BPP_METRICS_R2_BUCKET=
BPP_METRICS_R2_ACCESS_KEY_ID=
BPP_METRICS_R2_SECRET_ACCESS_KEY=

# Tunables (defaults per spec; uncomment to override)
# BPP_BUNDLE_RETENTION_DAYS=10
# BPP_KEEP_RELEASES=3
# BPP_MAX_RUN_SECONDS=7200
# BPP_DUCKDB_MEMORY_LIMIT=8GB
# BPP_DUCKDB_THREADS=8
